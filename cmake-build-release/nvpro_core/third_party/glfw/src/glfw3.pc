prefix=D:/code/field_n/_install
exec_prefix=${prefix}
includedir=D:/code/field_n/_install/include
libdir=D:/code/field_n/_install/lib

Name: GLFW
Description: A multi-platform library for OpenGL, window and input
Version: 3.3.8
URL: https://www.glfw.org/
Requires.private: 
Libs: -L${libdir} -lglfw3
Libs.private:  -lgdi32
Cflags: -I${includedir}
